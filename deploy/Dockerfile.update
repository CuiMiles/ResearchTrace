# Reuse a locally built, locked runtime; app code and static assets replace it.
ARG BASE_IMAGE=researchtrace:baseline
FROM ${BASE_IMAGE}
COPY --chown=10001:10001 services /app/services
COPY --chown=10001:10001 scripts/backup.py /app/scripts/backup.py
COPY --chown=10001:10001 deploy/web-dist /app/apps/web/dist
