# Build the web app on the development host, then copy its dist to deploy/web-dist.
# No frontend toolchain or private configuration is sent into the runtime image.
ARG REGISTRY=
FROM ${REGISTRY}python:3.12-slim-bookworm
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG DEBIAN_MIRROR=deb.debian.org
RUN sed -i "s|http://deb.debian.org|https://${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
 && apt-get -o Acquire::https::Timeout=30 -o Acquire::Retries=1 update \
 && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng fonts-droid-fallback \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir --no-compile -r requirements.lock
COPY services ./services
COPY scripts/backup.py ./scripts/backup.py
COPY deploy/web-dist ./apps/web/dist
RUN useradd --uid 10001 --create-home researchtrace \
 && mkdir -p /app/data && chown researchtrace:researchtrace /app/data
USER researchtrace
ENV RT_HOST=0.0.0.0 RT_PORT=18970 RT_DATA_DIR=/app/data MPLCONFIGDIR=/app/data/matplotlib \
    PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
EXPOSE 18970
CMD ["python", "-m", "services.api.serve"]
