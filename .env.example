# Server-only configuration. Never use VITE_* for provider secrets.
RT_HOST=127.0.0.1
RT_PORT=18970
RT_DATA_DIR=./data
RT_ACCESS_CODE=replace-with-private-reviewer-code
RT_ADMIN_CODE=replace-with-different-admin-code
# Guest entrance (no access code). Each guest gets an isolated workspace that
# expires; all generation uses RT_GUEST_MODEL_CHAIN and retrieval uses the Gemini
# embedding index copied from RT_GUEST_SEED_WORKSPACE (a small template space
# with a ready Gemini generation). Guest calls share the same project ledger;
# the caps below are server-side and count failed/unknown requests too.
RT_GUEST_MODE=false
RT_GUEST_SEED_WORKSPACE=
RT_GUEST_MODEL_CHAIN=gemini-3.5-flash-lite
RT_GUEST_DAILY_CALLS=20
RT_GUEST_GLOBAL_DAILY_CALLS=300
RT_GUEST_HOURS=24
RT_GUEST_MAX_ACTIVE=60
RT_GUEST_PER_CLIENT_HOURLY=3
RT_GUEST_MAX_DOCUMENTS=5
GEMINI_API_KEY=
GEMINI_API_KEY2=
# Map credentials to actual quota projects. Same project MUST use the same label.
GEMINI_PROJECT_1=gemini-shared
GEMINI_PROJECT_2=gemini-shared
GEMINI_PROXY=
# Only for networks whose egress proxy re-signs TLS. Verification stays on.
RT_CA_BUNDLE=
GEMINI_CORE_MODEL=gemini-4-hydrogen
GEMINI_BATCH_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Model roles: comma-separated chains, first usable model answers. ---------
# A later model is used only after a local budget refusal or a definite provider
# error; timeouts with unknown outcome are never re-sent. The UI shows the model
# that actually answered and marks a downgrade.
#   deep   : comparisons, surveys, Future Work, writing   (empty = core model)
#   answer : single-paper questions                       (empty = deep chain)
#   light  : routing, planning, extraction, translation   (empty = batch model)
#   verify : independent claim review                     (empty = deep chain)
RT_MODEL_DEEP=gemini-4-hydrogen,gemini-3.6-flash,gemini-3.5-flash-lite
RT_MODEL_ANSWER=gemini-4-hydrogen,gemini-3.6-flash,gemini-3.5-flash-lite
RT_MODEL_LIGHT=gemini-3.5-flash-lite,gemini-3.6-flash
RT_MODEL_VERIFY=gemini-3.5-flash-lite,gemini-3.6-flash
# Per-project RPM / input TPM / RPD. Each key with its own GEMINI_PROJECT_n label
# is one quota project; keys sharing a label share these limits.
RT_MODEL_PROJECT_LIMITS='{"gemini-4-hydrogen":[5,250000,20],"gemini-3.6-flash":[5,250000,20],"gemini-3.5-flash-lite":[15,250000,500]}'
# Optional totals per model per Pacific day across all projects.
RT_MODEL_DAILY_LIMITS='{"gemini-4-hydrogen":40,"gemini-3.6-flash":40,"gemini-decision-1":100}'
# Independent claim review after every answer.
RT_EVIDENCE_CRITIC=true
# Gemini Decision 1 reviews each claim (supported / contradicted / insufficient with
# probabilities; below 0.9 probability, 0.8 confidence or 0.25 margin it stays
# "review pending"). It has its own quota, so it does not consume the answer models.
# If it is unavailable the generative reviewer (RT_MODEL_VERIFY) is used instead.
RT_DECISION_ENABLED=true
RT_EVIDENCE_REVIEW_PROVIDER=decision1
RT_DECISION_REVIEW_FALLBACK=true
RT_DECISION_WORKFLOW_LIMIT=3
ENABLE_DENSE=true
# --- Budgets. Failed and unknown calls always count. ----------------------
# smoke      : integration tests, HYDROGEN_SMOKE_LIMIT core calls in total
# evaluation : quality runs, HYDROGEN_EVALUATION_LIMIT core calls in total
# judging    : the public site, HYDROGEN_JUDGING_LIMIT core calls in total
RT_BUDGET_PROFILE=smoke
HYDROGEN_SMOKE_LIMIT=4
HYDROGEN_EVALUATION_LIMIT=
HYDROGEN_JUDGING_LIMIT=
# Core-model calls per workspace per day, and per single task.
HYDROGEN_SESSION_LIMIT=2
HYDROGEN_WORKFLOW_LIMIT=2
# All generation models: calls per task, and per workspace per day.
RT_WORKFLOW_MODEL_CALLS=60
RT_WORKSPACE_DAILY_CALLS=600
# true during automated integration; set false for deliberate interactive use.
# The smoke CLI enforces its own total call ceiling even in interactive mode.
RT_SMOKE_MODE=true
# Core calls per project per day before keeping the rest as a demo reserve.
HYDROGEN_RUNTIME_SOFT_RPD=16
# Judging example (two keys on separate projects, 20 core calls each per day,
# about two weeks of judging): RT_BUDGET_PROFILE=judging,
# HYDROGEN_JUDGING_LIMIT=560, HYDROGEN_SESSION_LIMIT=8, RT_SMOKE_MODE=false,
# GEMINI_PROJECT_1=gemini-a, GEMINI_PROJECT_2=gemini-b.
ALLOW_PAID_FALLBACK=false
RT_SECURE_COOKIE=false
# Optional local parsing broker (separate from the lite API/worker memory budget).
# Paths default to project-private .tools directories; never copy old virtualenvs.
# RT_PARSER_SOCKET=/absolute/project/data/parsing/parser.sock
RT_GPU_RESERVE_MIB=2048
RT_GPU_MAX_MIB=2048
RT_PARSER_TIMEOUT_SECONDS=300
# GPU inference stops if own-process telemetry is unavailable (e.g. WSL NVML N/A).

# Two confirmed projects use distinct logical IDs; actual Google numeric IDs are
# optional, but never label two keys from the same project as independent.
RT_PREFERRED_CREDENTIAL=1
# Preserve historical project accounting when changing a logical label, e.g.
# {"previous-shared-label":"the-confirmed-original-project"}. Never rewrite quota.
RT_LEGACY_PROJECT_MAP={}
# Interactive local model cold-start bounds; separate offline evaluation may wait.
RT_RETRIEVAL_QUERY_TIMEOUT=15
RT_RERANK_TIMEOUT=45
# During migration, give each model purpose exactly one spending environment.
# all | embedding_only | generation_only | disabled; no budget counters reset.
RT_PROVIDER_MODE=all
