{"sql": "SELECT v.*,COALESCE(a.parse_id,v.id) active_parse_id FROM versions v LEFT JOIN active_parses a ON a.version_id=v.id WHERE v.workspace=? AND v.deleted=0 ORDER BY v.created DESC", "rows": 10, "seconds": 0.0056}
{"sql": "SELECT a.version_id,a.model_id,g.id generation_id,g.status,count(DISTINCT b.id) covered\n       FROM active_retrieval_indices a JOIN index_generations g ON g.id=a.generation_id\n       LEFT JOIN retrieval_chunks c ON c.generation_id=g.id AND c.version_id=a.version_id AND c.workspace=a.workspace\n       LEFT JOIN retrieval_spans s ON s.chunk_id=c.id\n       LEFT JOIN current_blocks b ON b.id=s.block_id AND b.workspace=a.workspace AND b.version_id=a.version_id\n       WHERE a.workspace=? GROUP BY a.version_id,a.model_id,g.id", "rows": 50, "seconds": 4.735}
plan [{"id": 3, "parent": 0, "notused": 0, "detail": "MATERIALIZE current_blocks"}, {"id": 10, "parent": 3, "notused": 0, "detail": "SCAN b"}, {"id": 12, "parent": 3, "notused": 0, "detail": "SEARCH bp USING INDEX sqlite_autoindex_block_parses_1 (block_id=?) LEFT-JOIN"}, {"id": 20, "parent": 3, "notused": 0, "detail": "SEARCH a USING INDEX sqlite_autoindex_active_parses_1 (version_id=?) LEFT-JOIN"}, {"id": 72, "parent": 0, "notused": 0, "detail": "SEARCH a USING INDEX sqlite_autoindex_active_retrieval_indices_1 (workspace=?)"}, {"id": 79, "parent": 0, "notused": 0, "detail": "SEARCH g USING INDEX sqlite_autoindex_index_generations_1 (id=?)"}, {"id": 84, "parent": 0, "notused": 0, "detail": "SEARCH c USING INDEX chunks_generation (generation_id=? AND version_id=?) LEFT-JOIN"}, {"id": 96, "parent": 0, "notused": 0, "detail": "SEARCH s USING COVERING INDEX sqlite_autoindex_retrieval_spans_1 (chunk_id=?) LEFT-JOIN"}, {"id": 117, "parent": 0, "notused": 0, "detail": "SEARCH b USING AUTOMATIC COVERING INDEX (id=? AND workspace=? AND version_id=?) LEFT-JOIN"}, {"id": 174, "parent": 0, "notused": 0, "detail": "USE TEMP B-TREE FOR count(DISTINCT)"}]
