{"sql": "SELECT v.*,COALESCE(a.parse_id,v.id) active_parse_id FROM versions v LEFT JOIN active_parses a ON a.version_id=v.id WHERE v.workspace=? AND v.deleted=0 ORDER BY v.created DESC", "rows": 10, "seconds": 0.0019}
{"sql": "SELECT a.version_id,a.model_id,g.id generation_id,g.status,\n       count(DISTINCT CASE WHEN COALESCE(bp.parse_id,b.version_id)=COALESCE(p.parse_id,a.version_id) THEN b.id END) covered\n       FROM active_retrieval_indices a JOIN index_generations g ON g.id=a.generation_id\n       JOIN versions d ON d.id=a.version_id AND d.workspace=a.workspace AND d.deleted=0\n       LEFT JOIN active_parses p ON p.version_id=a.version_id\n       LEFT JOIN retrieval_chunks c ON c.generation_id=g.id AND c.version_id=a.version_id AND c.workspace=a.workspace\n          AND c.parse_id=COALESCE(p.parse_id,a.version_id)\n       LEFT JOIN retrieval_spans s ON s.chunk_id=c.id\n       LEFT JOIN blocks b ON b.id=s.block_id AND b.workspace=a.workspace AND b.version_id=a.version_id\n       LEFT JOIN block_parses bp ON bp.block_id=b.id\n       WHERE a.workspace=? AND a.model_id IN (?,?) GROUP BY a.version_id,a.model_id,g.id", "rows": 20, "seconds": 0.2848}
plan [{"id": 20, "parent": 0, "notused": 0, "detail": "SEARCH a USING INDEX sqlite_autoindex_active_retrieval_indices_1 (workspace=?)"}, {"id": 30, "parent": 0, "notused": 0, "detail": "SEARCH d USING INDEX sqlite_autoindex_versions_1 (id=?)"}, {"id": 41, "parent": 0, "notused": 0, "detail": "SEARCH g USING INDEX sqlite_autoindex_index_generations_1 (id=?)"}, {"id": 46, "parent": 0, "notused": 0, "detail": "SEARCH p USING INDEX sqlite_autoindex_active_parses_1 (version_id=?) LEFT-JOIN"}, {"id": 53, "parent": 0, "notused": 0, "detail": "SEARCH c USING INDEX chunks_generation (generation_id=? AND version_id=?) LEFT-JOIN"}, {"id": 70, "parent": 0, "notused": 0, "detail": "SEARCH s USING COVERING INDEX sqlite_autoindex_retrieval_spans_1 (chunk_id=?) LEFT-JOIN"}, {"id": 77, "parent": 0, "notused": 0, "detail": "SEARCH b USING INDEX sqlite_autoindex_blocks_1 (id=?) LEFT-JOIN"}, {"id": 91, "parent": 0, "notused": 0, "detail": "SEARCH bp USING INDEX sqlite_autoindex_block_parses_1 (block_id=?) LEFT-JOIN"}, {"id": 164, "parent": 0, "notused": 0, "detail": "USE TEMP B-TREE FOR count(DISTINCT)"}]
{"sql": "SELECT id,status,payload FROM runs WHERE workspace=? AND kind='index' AND status IN ('queued','running','waiting_batch','failed','partial') ORDER BY created DESC", "rows": 0, "seconds": 0.0016}
{"sql": "SELECT id FROM versions WHERE workspace=? AND deleted=0", "rows": 10, "seconds": 0.0023}
