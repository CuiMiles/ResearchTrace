        "text": "3.2 Supervised fine-tuning",
        "source": "pdfplumber",
        "quality": "native",
        "metadata": {
          "citation_markers": [],
          "layout": "single_column",
          "parse_id": "183049f27bb7449a93faec0b1d9e30d6",
